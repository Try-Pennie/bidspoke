{
  "queryId": "ops-ceilings-spike-scheduled",
  "timeframe": { "from": 0, "to": 0 },
  "parameters": {
    "datasets": ["cloudflare-workers"],
    "filters": [
      { "key": "$metadata.service", "operation": "eq", "value": "WORKER", "type": "string" },
      { "key": "$workers.eventType", "operation": "eq", "value": "scheduled", "type": "string" },
      { "key": "$workers.wallTimeMs", "operation": "exists", "type": "number" }
    ],
    "calculations": [
      { "operator": "max", "key": "$workers.wallTimeMs", "keyType": "number", "alias": "max_wall_ms" },
      { "operator": "max", "key": "$workers.cpuTimeMs", "keyType": "number", "alias": "max_cpu_ms" },
      { "operator": "count", "alias": "invocations_sampled" }
    ],
    "groupBys": [
      { "type": "string", "value": "$workers.event.cron" },
      { "type": "string", "value": "$workers.outcome" }
    ]
  },
  "view": "calculations"
}
