{
  "name": "bidspoke",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:worker": "pnpm --filter worker dev",
    "build:web": "pnpm --filter web build",
    "build:worker": "pnpm --filter worker build",
    "lint": "pnpm -r lint",
    "test:worker": "pnpm --filter worker test",
    "typecheck": "pnpm -r typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "ws": ">=8.21.0 <9",
      "glob@>=10.2.0 <10.5.0": ">=10.5.0 <11",
      "postcss@<8.5.12": ">=8.5.12 <9",
      "nanoid@<3.3.18": ">=3.3.18 <4"
    }
  }
}
