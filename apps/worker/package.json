{
  "name": "worker",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "test": "vitest run && pnpm --filter=web exec vitest run src/lib/__guards__/worker",
    "test:unit": "vitest run",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "db:types": "bash scripts/gen-db-types.sh"
  },
  "dependencies": {
    "@bidspoke/references": "workspace:*",
    "@bidspoke/uuidv7": "workspace:*",
    "@supabase/supabase-js": "^2.112.4",
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260829.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.6.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
