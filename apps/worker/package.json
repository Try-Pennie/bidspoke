{
  "name": "worker",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "test": "vitest run && vitest run --config vitest.do.config.mts && pnpm --filter=web exec vitest run src/lib/__guards__/worker",
    "test:unit": "vitest run",
    "test:do": "vitest run --config vitest.do.config.mts",
    "lint": "eslint \"src/**/*.ts\" \"money-gate/**/*.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.do.json",
    "db:types": "bash scripts/gen-db-types.sh"
  },
  "dependencies": {
    "@bidspoke/references": "workspace:*",
    "@bidspoke/uuidv7": "workspace:*",
    "@bidspoke/script-hygiene": "workspace:*",
    "@bidspoke/buyer-profile": "workspace:*",
    "@bidspoke/node-types": "workspace:*",
    "@bidspoke/porting-evidence": "workspace:*",
    "@bidspoke/workflow-definition": "workspace:*",
    "@supabase/supabase-js": "^2.117.3",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261009.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.6.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.149.0"
  }
}
