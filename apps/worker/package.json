{
  "name": "worker",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "test": "vitest run && pnpm --filter=web exec vitest run src/lib/__guards__/worker",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "db:types": "bash scripts/gen-db-types.sh"
  },
  "dependencies": {
    "@bidspoke/uuidv7": "workspace:*",
    "@supabase/supabase-js": "^2.112.3",
    "hono": "^4.13.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260817.1",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.6.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
