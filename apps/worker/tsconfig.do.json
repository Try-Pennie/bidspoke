{
  // Typecheck for the Workers test project (#1410). The *.workers.test.ts files
  // import from cloudflare:test and cloudflare:workers, whose ambient types come
  // from the Vitest plugin, so the main tsconfig excludes them and this one adds
  // the types back. The typecheck script runs it alongside the other two.
  //
  // money-gate runs in workerd the same way (#1704). Its harness imports the engine
  // under test through the @money-gate-engine alias, which
  // vitest.money-gate.config.mts points at the merge base or the head, and its
  // fixtures through JSON and import.meta.glob, hence the extra options.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
    "noEmit": true,
    "resolveJsonModule": true,
    "paths": { "@money-gate-engine/*": ["./src/*"] }
  },
  "include": ["src", "money-gate/harness/*.workers.test.ts", "money-gate/harness/import-meta.d.ts"],
  "exclude": []
}
