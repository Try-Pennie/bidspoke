{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  // The Workers test project owns these and brings their ambient types; see
  // tsconfig.do.json, which the typecheck script also runs.
  "exclude": ["src/durable-objects/__tests__/*.workers.test.ts"]
}
