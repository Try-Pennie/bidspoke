{
  "workflow_id": "89b1a6af-7e0f-43de-bc66-1e888184551f",
  "workflow_name": "Lead Economy - Bidding Workflow",
  "replaces": {
    "node_id": "83ceda70-bea4-448b-9ec8-800527ae25ab",
    "namespace": "validate_bidding_and_state",
    "script_md5": "ec51b792c80fe2d37ee050880ab5d026"
  },
  "node": {
    "id": "83ceda70-bea4-448b-9ec8-800527ae25ab",
    "namespace": "validate_bidding_and_state",
    "label": "Validate Bidding and State",
    "type": "lead_validation",
    "position": {
      "x": 658,
      "y": 660
    },
    "config": {
      "lead_id_field": "trigger.payload.leadId1",
      "checks": [
        {
          "id": "bidding_active",
          "label": "Bidding is on in Salesforce",
          "condition": {
            "logic": "AND",
            "groups": [
              {
                "logic": "AND",
                "conditions": [
                  {
                    "field": "steps.custom_request.output.body.IsActive",
                    "operator": "is_true"
                  }
                ]
              }
            ]
          },
          "reason": "bidding not active",
          "on_missing": "reject"
        },
        {
          "id": "state",
          "label": "State is one we take",
          "condition": {
            "logic": "AND",
            "groups": [
              {
                "logic": "AND",
                "conditions": [
                  {
                    "field": "trigger.payload.personalInformation.state",
                    "operator": "in_array",
                    "value": "steps.constants.output.states"
                  }
                ]
              }
            ]
          },
          "reason": "ineligible state",
          "on_missing": "reject"
        },
        {
          "id": "name",
          "label": "First and last name are given",
          "condition": {
            "logic": "AND",
            "groups": [
              {
                "logic": "AND",
                "conditions": [
                  {
                    "field": "steps.parsed_name.output.firstName",
                    "operator": "not_blank"
                  },
                  {
                    "field": "steps.parsed_name.output.lastName",
                    "operator": "not_blank"
                  }
                ]
              }
            ]
          },
          "reason": "invalid name",
          "on_missing": "reject"
        },
        {
          "id": "phone",
          "label": "Phone is given",
          "condition": {
            "logic": "AND",
            "groups": [
              {
                "logic": "AND",
                "conditions": [
                  {
                    "field": "trigger.payload.personalInformation.primaryPhone",
                    "operator": "not_blank"
                  }
                ]
              }
            ]
          },
          "reason": "missing phone",
          "on_missing": "reject"
        },
        {
          "id": "qualified",
          "label": "Loan, income, purpose and employment qualify",
          "condition": {
            "logic": "AND",
            "groups": [
              {
                "logic": "AND",
                "conditions": [
                  {
                    "field": "trigger.payload.loanInformation.loanAmount",
                    "operator": "gte",
                    "value": "steps.constants.output.minimumLoanAmount"
                  },
                  {
                    "field": "trigger.payload.financialInformation.annualIncome",
                    "operator": "gte",
                    "value": "steps.constants.output.minimumAnnualIncome"
                  },
                  {
                    "field": "trigger.payload.loanInformation.purpose",
                    "operator": "in_array",
                    "value": "steps.constants.output.allowedPurposes"
                  },
                  {
                    "field": "trigger.payload.financialInformation.employmentStatus",
                    "operator": "in_array",
                    "value": "steps.constants.output.allowedEmploymentStatuses"
                  }
                ]
              }
            ]
          },
          "reason": "unqualified_lead",
          "on_missing": "reject",
          "include_request_id": true
        }
      ],
      "response_headers": {
        "Content-Type": "application/json"
      }
    },
    "variables": {}
  },
  "constants_data": {
    "minimumLoanAmount": 2000
  },
  "grid_accepted": [
    {
      "arm": "loanAmount=[limit]",
      "kind": "node_rejects",
      "check": "qualified",
      "reason": "The script reads a one item list as its item (Number([x]) and [x] >= limit), so a loanAmount sent as a list goes on. The node judges only a number or numeric text and rejects it as unqualified_lead."
    },
    {
      "arm": "annualIncome=[limit]",
      "kind": "node_rejects",
      "check": "qualified",
      "reason": "The script reads a one item list as its item (Number([x]) and [x] >= limit), so a annualIncome sent as a list goes on. The node judges only a number or numeric text and rejects it as unqualified_lead."
    }
  ],
  "gate_accepted": [
    {
      "workflow": "Lead Economy - Bidding Workflow",
      "check": "supabase_write",
      "field": "update lead_sightings values.reject_reason",
      "reason": "Intended by #934 (plan item 6, shipped in #2589): deriveRejectReason records a lead validation rejection on the sighting as lead_validation:<reason>, where a script rejection recorded none."
    },
    {
      "workflow": "Lead Economy - Bidding Workflow",
      "check": "supabase_write",
      "field": "update workflow_executions values.sighting_finalize.reject_reason",
      "reason": "Intended by #934 (plan item 6, shipped in #2589): deriveRejectReason records a lead validation rejection on the sighting as lead_validation:<reason>, where a script rejection recorded none."
    },
    {
      "workflow": "Lead Economy - Bidding Workflow",
      "check": "kv_state",
      "field": "kv_state.IDEMPOTENCY.answer-journal:*.sighting_finalize.reject_reason",
      "reason": "Intended by #934 (plan item 6, shipped in #2589): deriveRejectReason records a lead validation rejection on the sighting as lead_validation:<reason>, where a script rejection recorded none."
    },
    {
      "workflow": "Lead Economy - Bidding Workflow",
      "check": "supabase_write",
      "field": "insert execution_steps values[*]*minimumLoanAmount",
      "reason": "Dan, 2026-10-21 (#934 phase 0): the script's hard coded 2000 becomes the Constants minimumLoanAmount, replacing 1000, so the Constants step row records 2000. No other step of the workflow reads minimumLoanAmount (checked on the committed definition, 2026-10-21)."
    }
  ]
}
