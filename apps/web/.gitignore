# Generated by scripts/sync-docs.mjs from the repo docs/ folder.
# Regenerated automatically on predev / prebuild / prepages:build.
/public/docs/
/public/llms.txt

# Cloudflare/Vercel build output — regenerated by `pages:build` at deploy time.
# Never commit (stale artifact + noise for the secret scanner).
/.vercel/

# Playwright auth storage — regenerated by e2e/global-setup at test time.
# Holds a live test-account session token; must not be committed.
/e2e/.auth/
