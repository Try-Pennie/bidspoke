{
  "about": "The paths a buyer profile document flattens to, in both spellings (#2132). 'ts' is what flattenProfileDocument in src/diff.ts produces and the partners page registry is keyed by; 'sql' is what public.buyer_profile_flatten produces and audit rows carry. Vitest checks the TypeScript flatten and normaliseSqlPath against it; supabase/tests/buyer_profile_flatten_paths.test.sql checks the SQL flatten. Not a valid profile: flatten does not validate, and one document covers every row kind and every scalar.",
  "cases": [
    {
      "name": "every row kind and every scalar",
      "document": {
        "sold_on": "click",
        "is_enabled": true,
        "priority": 2,
        "allowed_states": ["TX", "CA"],
        "debt_min": 10000,
        "debt_max": 50000,
        "loan_amount_min": 5000,
        "hourly_lead_cap": 5,
        "daily_lead_cap": 40,
        "hourly_spend_cap_cents": 10000,
        "daily_spend_cap_cents": 50000,
        "display_time_zone": "America/Chicago",
        "windows": [{ "day_of_week": 1, "opens_minute": 540, "closes_minute": 1020 }],
        "blackout_dates": [{ "date": "2026-12-25", "note": "Holiday" }],
        "tiers": [
          { "population": "engine", "debt_from": 10000, "debt_to": 20000, "multiplier": 0.02 },
          { "population": "engine", "debt_from": 20000.5, "debt_to": null, "multiplier": 0.01 }
