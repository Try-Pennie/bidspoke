# Tree matches commit (#889): local checks read the WORKING TREE, CI reads the
# COMMIT. When they diverge every local signal is green and the PR is broken, and
# nothing local can see it, because every local tool is on the wrong side of the
# divergence. This is the class that produced PR #888: a partially-bad `git add`
# staged nothing, so the commit kept a stale import while the full local suite
# passed. Runs first, and fast (one git call), because every check after it is
# only meaningful if this one holds. Skip with SKIP_TREE_CHECK=1.
node scripts/verify-tree-matches-commit.mjs

node scripts/typecheck-tracked.mjs

# Docs integrity (#382): catch a broken doc link or a page missing from llms.txt
# locally, instead of as a red CI Test / Deploy Verify after pushing. Fast
# (<1s), no side effects. Skip with SKIP_DOCS_CHECK=1 if ever needed.
if [ -z "$SKIP_DOCS_CHECK" ]; then
  pnpm --filter=web docs:check
fi

# Copy guards (#415): the em-dash / emoji scans are vitest tests in apps/web, so
# they run in CI's test job but NOT in this pre-push gate. A banned character in
# new alert or UI copy (e.g. apps/worker/src/lib/slack.ts) therefore passes the
# push locally and only turns CI red afterward. Run them here too (fast, ~100ms).
# Skip with SKIP_COPY_CHECK=1 if ever needed.
if [ -z "$SKIP_COPY_CHECK" ]; then
  pnpm --filter=web test run em-dash emoji
fi

# SQL suite (#1409, #1139): when this branch touches supabase/ or the read only
# rpc list, replay every migration from empty onto a throwaway Postgres in
# Docker and run supabase/tests/*.test.sql against it. Before this existed no
# SQL in the repo had ever run against a real database before reaching
# production (#1139). It refuses the push by name when Docker is not running
# rather than passing on nothing (L98). Roughly two minutes on a cold database,
# seconds when the container is already up. Skip with SKIP_SQL_SUITE=1 for ONE
# push, after saying why.
#
# Which suites run is decided from the branch's own changes since its merge base
# with origin/main, not from the upstream (#2412): see the script for why, and
# for the fallback to both suites when that merge base cannot be computed.
if [ -z "$SKIP_SQL_SUITE" ]; then
  sql_suites=$(bash scripts/pre-push-sql-suites.sh)
  if printf '%s\n' "$sql_suites" | grep -qx main; then
    bash scripts/sql-suite/run.sh
  fi
  # The ops database (#1709) has its own migrations, tests and container.
  if printf '%s\n' "$sql_suites" | grep -qx ops; then
    SQL_SUITE_PROJECT=ops bash scripts/sql-suite/run.sh
  fi
fi
